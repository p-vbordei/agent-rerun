{
  "name": "agent-rerun",
  "version": "0.1.1",
  "description": "Portable reproducibility seed bundle for AI-agent steps",
  "author": "Vlad Bordei <bordeivlad@gmail.com>",
  "homepage": "https://github.com/p-vbordei/agent-rerun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-vbordei/agent-rerun.git"
  },
  "bugs": {
    "url": "https://github.com/p-vbordei/agent-rerun/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "rerun": "src/cli.ts"
  },
  "files": ["src", "examples", "README.md", "SPEC.md", "SCOPE.md", "CHANGELOG.md", "LICENSE"],
  "keywords": [
    "llm",
    "agent",
    "reproducibility",
    "replay",
    "determinism",
    "slsa",
    "ed25519",
    "jcs"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "conformance": "bun run conformance/run.ts",
    "build": "bun build --compile src/cli.ts --outfile dist/rerun"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "canonicalize": "^2.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
